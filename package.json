{
  "name": "tz-praktikum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Учебный тренажёр: переписка с заказчиком и составление технического задания на САУ",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "docs": "vitest run src/docs.test.ts --mode docs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/ui": "^4.12.0",
    "@vueuse/core": "^15.0.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  }
}
